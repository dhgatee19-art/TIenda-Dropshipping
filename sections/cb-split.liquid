{%- render 'cb-section-style', section: section -%}
{%- assign s = section.settings -%}
{% style %}
  #shopify-section-{{ section.id }} .cb-split__media { --cb-ratio: {{ s.proporcion }}; }
{% endstyle %}
<section class="cb-section">
  <div class="cb-container">
    <div class="cb-split{% if s.invertido %} cb-split--invertido{% endif %}">
      <div class="cb-split__media cb-reveal">
        {% render 'cb-img', img: s.imagen, fallback: 'cb-tu-tranquilo.jpg', alt: 'Persona relajada en el sofá mientras su gato juega solo con Catboing', width: 1400 %}
        {%- if s.sticker != blank -%}<span class="cb-split__sticker">{{ s.sticker }}</span>{%- endif -%}
      </div>
      <div class="cb-split__text cb-align">
        {%- if s.eyebrow != blank -%}<span class="cb-eyebrow cb-reveal">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="cb-h2 cb-reveal" style="--cb-i:1">{{ s.titulo }}</h2>
        {%- if s.texto != blank -%}<div class="cb-body cb-reveal" style="--cb-i:2">{{ s.texto | newline_to_br }}</div>{%- endif -%}
        {%- if s.lista != blank -%}
          <ul class="cb-lista cb-reveal" style="--cb-i:3">
            {%- assign lineas = s.lista | newline_to_br | split: '<br />' -%}
            {%- for l in lineas -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li><span class="cb-check">{% render 'cb-icon', name: 'check' %}</span><span>{{ t }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.boton_texto != blank -%}
          <div class="cb-reveal" style="--cb-i:4"><a href="{{ s.boton_url | default: routes.all_products_collection_url }}" class="cb-btn{% if s.boton_oscuro %} cb-btn--oscuro{% endif %}">{{ s.boton_texto }}{% render 'cb-icon', name: 'flecha' %}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CB – Imagen con texto",
  "tag": "section",
  "class": "cb-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "imagen",
      "label": "Imagen"
    },
    {
      "type": "checkbox",
      "id": "invertido",
      "label": "Imagen a la derecha",
      "default": false
    },
    {
      "type": "select",
      "id": "proporcion",
      "label": "Forma de la imagen",
      "options": [
        {
          "value": "4/3",
          "label": "Horizontal"
        },
        {
          "value": "1/1",
          "label": "Cuadrada"
        },
        {
          "value": "4/5",
          "label": "Vertical"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Pegatina sobre la imagen (vacío = sin pegatina)",
      "default": "¡Juega solo!"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "El problema"
    },
    {
      "type": "inline_richtext",
      "id": "titulo",
      "label": "Título",
      "default": "Un gato aburrido es un gato <em>travieso</em>",
      "info": "Pon palabras en cursiva para que salgan en color, o en negrita para subrayarlas."
    },
    {
      "type": "textarea",
      "id": "texto",
      "label": "Texto",
      "default": "Arañazos en el sofá, carreras a las 3 de la madrugada, energía acumulada… Los gatos de casa necesitan cazar cada día, pero tú no siempre puedes estar con la varita en la mano."
    },
    {
      "type": "textarea",
      "id": "lista",
      "label": "Lista de ventajas (una por línea)",
      "default": "Juega solo mientras teletrabajas, cocinas o descansas\nGasta energía y se aburre menos en casa\nSin pilas, sin enchufes y sin ruidos"
    },
    {
      "type": "text",
      "id": "boton_texto",
      "label": "Texto del botón (vacío = sin botón)"
    },
    {
      "type": "url",
      "id": "boton_url",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "boton_oscuro",
      "label": "Botón oscuro",
      "default": true
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño del texto",
      "min": 13,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo de la sección",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Color del texto",
      "default": "#2B2A30"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "CB – Imagen con texto"
    }
  ]
}
{% endschema %}
